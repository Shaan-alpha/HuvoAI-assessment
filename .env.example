# Template only — never put a real key in this file, it is committed.
# Copy to .env (which is gitignored) and put your key there instead.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Free-tier quota is metered per model, and the DAILY cap binds hardest:
# gemini-3.8-flash allows only 20 requests/day. The lite tier is far more
# generous, and 3.5-flash-lite holds up on Hinglish where 3.1-flash-lite
# drops into English. Each of the three draws its own separate quota.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_ANALYTICS_MODEL=gemini-3.1-flash-lite
